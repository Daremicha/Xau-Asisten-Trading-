# ---------------------------------------------------------------------------
# Market data (required for the app to show any price at all)
# ---------------------------------------------------------------------------
# TWELVE_DATA_API_KEY: primary XAU/USD spot feed. A free key at twelvedata.com
# is enough for 15 minute candles. Without it the app falls back to the public
# Yahoo Finance gold futures endpoint, which is unofficial and often rate
# limited. If neither provider answers, the UI reports that data is
# unavailable; it never shows an invented price.
TWELVE_DATA_API_KEY=""

# ---------------------------------------------------------------------------
# Language model providers (optional)
# ---------------------------------------------------------------------------
# These only write the narrative around the setup. Every price level is
# produced by the deterministic structural engine, so the app is fully
# functional with none of these set.

# GEMINI_API_KEY: primary narrative model.
GEMINI_API_KEY=""

# OPENAI_API_KEY: secondary, used if Gemini is rate limited.
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: tertiary, used if the first two are exhausted.
ANTHROPIC_API_KEY=""

# CLAUDE_API_KEY: alternative alias for the Anthropic key.
CLAUDE_API_KEY=""

# APP_URL: the URL where this app is hosted.
APP_URL=""

# TWELVE_DATA_BASE_URL: optional override of the Twelve Data endpoint, for a
# self hosted proxy or a local fixture server. Defaults to the public API.
TWELVE_DATA_BASE_URL=""

# MARKET_DATA_CACHE_SECONDS: how long a quote is reused before refetching.
# This controls your daily provider usage. The default of 60 keeps the free
# Twelve Data tier (800 requests/day) safe. Lower it only on a paid plan.
MARKET_DATA_CACHE_SECONDS="60"

# ---------------------------------------------------------------------------
# Firebase (optional, only needed for signing in and cloud sync)
# ---------------------------------------------------------------------------
# The app works fully without these. Without sign-in your equity, settings and
# learning history are saved in the browser instead of the cloud.
#
# Set them only if you want Google sign-in and you do not own the Firebase
# project bundled with this repository. Copy the values from your own project:
# Firebase Console, Project settings, Your apps, SDK setup and configuration.
#
# These values are public by design; they appear in every browser that loads
# the app. Firestore security rules, not secrecy, protect your data.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Leave blank unless your Firestore uses a named database rather than (default).
NEXT_PUBLIC_FIREBASE_DATABASE_ID=""

# ---------------------------------------------------------------------------
# Economic calendar (optional)
# ---------------------------------------------------------------------------
# ECONOMIC_CALENDAR_URL: a JSON feed of scheduled releases. Each row needs a
# title and a time; country, currency, impact, forecast and previous are used
# when present. Without this the app shows no calendar and the engine ignores
# news entirely, rather than inventing a schedule.
ECONOMIC_CALENDAR_URL=""

# OPENAI_BASE_URL: optional override of the OpenAI endpoint, for a self hosted
# proxy or a compatible provider. Defaults to the public API.
OPENAI_BASE_URL=""

# ---------------------------------------------------------------------------
# Alerts with the app closed (optional)
# ---------------------------------------------------------------------------
# Without these, TP/SL alerts only arrive while the app is open. With them, the
# server watches each phone's open setup and pushes fills, near-stop and
# near-target warnings, target and stop hits, and missed orders.
#
# VAPID keys identify this server to the browsers' push services. Generate a
# pair once with `npx web-push generate-vapid-keys`. The private key is secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push services, a mailto: or https URL. Defaults to APP_URL.
VAPID_SUBJECT=""

# Storage for subscriptions: an Upstash Redis database. Connecting one through
# Vercel (Storage, Upstash for Redis) sets KV_REST_API_URL and
# KV_REST_API_TOKEN automatically; UPSTASH_REDIS_REST_URL/TOKEN also work.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# The check runs when something calls /api/push/check, once a minute, from
# an outside scheduler such as cron-job.org. Set this and call
# /api/push/check?key=<secret> so nobody else can trigger it. Checks are
# spaced at least 45 seconds apart either way.
PUSH_CRON_SECRET=""
