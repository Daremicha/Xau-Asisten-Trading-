# GEMINI_API_KEY: Primary intelligence model (Google Gemini 3.8 Flash).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Secondary fallback model (ChatGPT / GPT-4o).
# Automatically switches if Gemini free quota or rate limit is reached.
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Tertiary fallback model (Claude 3.7 / 3.5 Sonnet).
# Automatically switches if Gemini & ChatGPT quotas are exhausted.
ANTHROPIC_API_KEY=""

# CLAUDE_API_KEY: Alternative alias for Anthropic API key.
CLAUDE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
